{
  "name": "my-project",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:check": "eslint . --max-warnings 0",
    "format": "eslint . --fix --cache && prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "./scripts/lint-and-format.sh --fix",
    "quality:check": "./scripts/lint-and-format.sh --check-only",
    "lint:all": "pnpm run lint --recursive",
    "lint:fix:all": "pnpm run lint:fix --recursive",
    "format:all": "pnpm run format --recursive"
  },
  "pnpm": {
    "overrides": {}
  },
  "devDependencies": {
    "@my-project/tsconfig": "workspace:^",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3"
  },
  "resolutions": {},
  "packageManager": "pnpm@8.6.12+sha512.1336b80b948efd7979218a33ba96d9e4d380e6578144f6319979977deec6e3fe2e0a444b864b3ce2b077dda8adc4d654fee32b9c31868f0acb92da0abcf8ea1c"
}
